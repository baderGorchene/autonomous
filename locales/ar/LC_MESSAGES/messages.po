msgid "Logout"
msgstr "تسجيل الخروج"

msgid "Sign Up"
msgstr "التسجيل"

msgid "Login"
msgstr "تسجيل الدخول"

msgid "All rights reserved."
msgstr "جميع الحقوق محفوظة."

msgid "Create Your BookSlot Account"
msgstr "إنشاء حساب BookSlot الخاص بك"

msgid "Start managing your appointments with ease."
msgstr "ابدأ بإدارة مواعيدك بسهولة."

msgid "Error!"
msgstr "خطأ!"

msgid "Email already registered"
msgstr "البريد الإلكتروني مسجل بالفعل"

msgid "Business URL already taken"
msgstr "عنوان URL للنشاط التجاري مستخدم بالفعل"

msgid "An unexpected error occurred during signup."
msgstr "حدث خطأ غير متوقع أثناء التسجيل."

msgid "Your Name"
msgstr "اسمك"

msgid "Email Address"
msgstr "عنوان البريد الإلكتروني"

msgid "Password"
msgstr "كلمة المرور"

msgid "Business Name"
msgstr "اسم النشاط التجاري"

msgid "Your Booking Page URL (e.g., bookslot.app/your-name)"
msgstr "رابط صفحة الحجز الخاصة بك (مثال: bookslot.app/your-name)"

msgid "Phone Number (optional, for WhatsApp notifications)"
msgstr "رقم الهاتف (اختياري، لإشعارات واتساب)"

msgid "Already have an account?"
msgstr "هل لديك حساب بالفعل؟"

msgid "Login here"
msgstr "سجل الدخول من هنا"

msgid "Login to Your Account"
msgstr "تسجيل الدخول إلى حسابك"

msgid "Welcome back! Please enter your credentials."
msgstr "أهلاً بك مرة أخرى! يرجى إدخال بيانات الاعتماد الخاصة بك."

msgid "Incorrect email or password"
msgstr "البريد الإلكتروني أو كلمة المرور غير صحيحة"

msgid "Don't have an account?"
msgstr "أليس لديك حساب؟"

msgid "Sign up here"
msgstr "سجل من هنا"

msgid "Welcome,"
msgstr "أهلاً بك،"

msgid "Manage your bookings and business settings."
msgstr "إدارة حجوزاتك وإعدادات عملك."

msgid "Success!"
msgstr "نجاح!"

msgid "Profile updated successfully."
msgstr "تم تحديث الملف الشخصي بنجاح."

msgid "Services updated successfully."
msgstr "تم تحديث الخدمات بنجاح."

msgid "Availability updated successfully."
msgstr "تم تحديث التوفر بنجاح."

msgid "Failed to update profile. Please try again."
msgstr "فشل تحديث الملف الشخصي. الرجاء المحاولة مرة أخرى."

msgid "Your Booking Page"
msgstr "صفحة الحجز الخاصة بك"

msgid "Share this link with your customers to let them book appointments easily."
msgstr "شارك هذا الرابط مع عملائك لتمكينهم من حجز المواعيد بسهولة."

msgid "Copy Link"
msgstr "نسخ الرابط"

msgid "Upcoming Bookings"
msgstr "الحجوزات القادمة"

msgid "Profile Settings"
msgstr "إعدادات الملف الشخصي"

msgid "Services"
msgstr "الخدمات"

msgid "Availability"
msgstr "التوفر"

msgid "Customer Name"
msgstr "اسم العميل"

msgid "Service"
msgstr "الخدمة"

msgid "Date"
msgstr "التاريخ"

msgid "Time"
msgstr "الوقت"

msgid "Contact"
msgstr "الاتصال"

msgid "No upcoming bookings."
msgstr "لا توجد حجوزات قادمة."

msgid "Your Phone (for WhatsApp notifications)"
msgstr "رقم هاتفك (لإشعارات واتساب)"

msgid "Include country code, e.g., +1234567890. Required for WhatsApp notifications."
msgstr "تضمين رمز الدولة، مثال: +1234567890. مطلوب لإشعارات واتساب."

msgid "Update Profile"
msgstr "تحديث الملف الشخصي"

msgid "Your Booking Page URL"
msgstr "رابط صفحة الحجز الخاصة بك"

msgid "This URL is permanent and cannot be changed."
msgstr "هذا الرابط دائم ولا يمكن تغييره."

msgid "Your Services"
msgstr "خدماتك"

msgid "Define the services you offer. You can add, edit, or remove services."
msgstr "حدد الخدمات التي تقدمها. يمكنك إضافة الخدمات أو تعديلها أو إزالتها."

msgid "No services added yet. Click \"Add Service\" to get started."
msgstr "لم تتم إضافة أي خدمات بعد. انقر على \"إضافة خدمة\" للبدء."

msgid "Add Service"
msgstr "إضافة خدمة"

msgid "Save Services"
msgstr "حفظ الخدمات"

msgid "Service Name"
msgstr "اسم الخدمة"

msgid "Description (optional)"
msgstr "الوصف (اختياري)"

msgid "Duration (minutes)"
msgstr "المدة (بالدقائق)"

msgid "Price (optional)"
msgstr "السعر (اختياري)"

msgid "Your Availability"
msgstr "توفرك"

msgid "Set your working hours for each day of the week."
msgstr "حدد ساعات عملك لكل يوم من أيام الأسبوع."

msgid "Monday"
msgstr "الاثنين"

msgid "Tuesday"
msgstr "الثلاثاء"

msgid "Wednesday"
msgstr "الأربعاء"

msgid "Thursday"
msgstr "الخميس"

msgid "Friday"
msgstr "الجمعة"

msgid "Saturday"
msgstr "السبت"

msgid "Sunday"
msgstr "الأحد"

msgid "No slots defined. Click \"Add Slot\" to add one."
msgstr "لم يتم تحديد أوقات. انقر على \"إضافة وقت\" لإضافة واحد."

msgid "Add Slot"
msgstr "إضافة وقت"

msgid "Save Availability"
msgstr "حفظ التوفر"

msgid "Invalid JSON format for services. Please correct it."
msgstr "تنسيق JSON غير صالح للخدمات. يرجى تصحيحه."

msgid "Failed to update services. Please try again."
msgstr "فشل تحديث الخدمات. الرجاء المحاولة مرة أخرى."

msgid "Invalid JSON format for availability. Please correct it."
msgstr "تنسيق JSON غير صالح للتوفر. يرجى تصحيحه."

msgid "Validation error in availability: {ve}"
msgstr "خطأ في التحقق من التوفر: {ve}"

msgid "Failed to update availability. Please try again."
msgstr "فشل تحديث التوفر. الرجاء المحاولة مرة أخرى."

msgid "An unexpected error occurred."
msgstr "حدث خطأ غير متوقع."

msgid "Book an Appointment"
msgstr "احجز موعداً"

msgid "Owner not found"
msgstr "المالك غير موجود"

msgid "Book your next appointment with ease."
msgstr "احجز موعدك التالي بسهولة."

msgid "Your Details"
msgstr "تفاصيلك"

msgid "Your Email"
msgstr "بريدك الإلكتروني"

msgid "Your Phone (optional, for WhatsApp updates)"
msgstr "رقم هاتفك (اختياري، لتحديثات واتساب)"

msgid "Choose a Service"
msgstr "اختر خدمة"

msgid "minutes"
msgstr "دقيقة"

msgid "No services available at the moment. Please check back later."
msgstr "لا توجد خدمات متاحة حالياً. يرجى التحقق لاحقاً."

msgid "Select Date & Time"
msgstr "اختر التاريخ والوقت"

msgid "Preferred Date"
msgstr "التاريخ المفضل"

msgid "Available Time Slots"
msgstr "الأوقات المتاحة"

msgid "Please select a date to see available time slots."
msgstr "يرجى تحديد تاريخ لعرض الأوقات المتاحة."

msgid "Book Now"
msgstr "احجز الآن"

msgid "Failed to submit booking. Please check your details and try again."
msgstr "فشل إرسال الحجز. يرجى التحقق من التفاصيل والمحاولة مرة أخرى."

msgid "Booking Confirmed!"
msgstr "تم تأكيد الحجز!"

msgid "Thank you,"
msgstr "شكراً لك،"

msgid "valued customer"
msgstr "عميلنا الكرام"

msgid "Your appointment has been successfully booked."
msgstr "تم حجز موعدك بنجاح."

msgid "Service:"
msgstr "الخدمة:"

msgid "Date:"
msgstr "التاريخ:"

msgid "Time:"
msgstr "الوقت:"

msgid "With:"
msgstr "مع:"

msgid "A confirmation email has been sent to your inbox. Please check it for full details."
msgstr "تم إرسال رسالة تأكيد بالبريد الإلكتروني إلى صندوق الوارد الخاص بك. يرجى التحقق منها للحصول على التفاصيل الكاملة."

msgid "Book Another Appointment"
msgstr "احجز موعداً آخر"

msgid "New Booking Received!"
msgstr "تم استلام حجز جديد!"

msgid "Dear"
msgstr "عزيزي/عزيزتي"

msgid "Your appointment with"
msgstr "موعدك مع"

msgid "for the service"
msgstr "للخدمة"

msgid "has been successfully confirmed!"
msgstr "تم تأكيده بنجاح!"

msgid "Here are your booking details:"
msgstr "إليك تفاصيل حجزك:"

msgid "We look forward to seeing you!"
msgstr "نتطلع لرؤيتك!"

msgid "If you need to make changes, please contact"
msgstr "إذا كنت بحاجة إلى إجراء تغييرات، يرجى الاتصال بـ"

msgid "directly."
msgstr "مباشرة."

msgid "This is an automated email, please do not reply."
msgstr "هذا بريد إلكتروني آلي، يرجى عدم الرد عليه."

msgid "You have received a new booking through BookSlot!"
msgstr "لقد تلقيت حجزًا جديدًا عبر BookSlot!"

msgid "Here are the details:"
msgstr "إليك التفاصيل:"

msgid "Customer Name:"
msgstr "اسم العميل:"

msgid "Customer Email:"
msgstr "بريد العميل الإلكتروني:"

msgid "Customer Phone:"
msgstr "هاتف العميل:"

msgid "Please check your dashboard for full details."
msgstr "يرجى التحقق من لوحة التحكم الخاصة بك للحصول على التفاصيل الكاملة."

msgid "This is an automated email."
msgstr "هذا بريد إلكتروني آلي."

msgid "Dashboard"
msgstr "لوحة التحكم"

msgid "Copied!"
msgstr "تم النسخ!"

msgid "Please select a date and a service to see available time slots."
msgstr "الرجاء تحديد تاريخ وخدمة لعرض الأوقات المتاحة."

msgid "No available time slots for the selected date and service duration."
msgstr "لا توجد أوقات متاحة للتاريخ ومدة الخدمة المحددين."

msgid "This time slot has passed"
msgstr "انتهى هذا الوقت"

msgid "New booking for {service_name} on {booking_date} at {booking_time} by {customer_name}. Contact: {customer_phone} / {customer_email}."
msgstr "حجز جديد لـ {service_name} في {booking_date} الساعة {booking_time} بواسطة {customer_name}. الاتصال: {customer_phone} / {customer_email}."

msgid "N/A"
msgstr "غير متوفر"
