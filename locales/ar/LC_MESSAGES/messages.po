msgstr "إزالة الخدمة"

msgid "Services updated successfully!"
msgstr "تم تحديث الخدمات بنجاح!"

msgid "Invalid JSON format for services."
msgstr "تنسيق JSON غير صالح للخدمات."

msgid "Error updating services: {e}"
msgstr "خطأ في تحديث الخدمات: {e}"

msgid "Set Your Availability"
msgstr "تحديد توفرك"

msgid "No slots set for this day."
msgstr "لا توجد فترات محددة لهذا اليوم."

msgid "Add Slot"
msgstr "إضافة فترة"

msgid "Save Availability"
msgstr "حفظ التوفر"

