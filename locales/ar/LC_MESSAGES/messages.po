msgid "Sign Up for BookSlot"
msgstr "التسجيل في BookSlot"

msgid "Create Your Account"
msgstr "إنشاء حسابك"

msgid "An account with this email already exists."
msgstr "يوجد حساب بهذا البريد الإلكتروني بالفعل."

msgid "This slug is already taken. Please choose another."
msgstr "هذا الرابط مأخوذ بالفعل. يرجى اختيار رابط آخر."

msgid "Your Name"
msgstr "اسمك"

msgid "Email"
msgstr "البريد الإلكتروني"

msgid "Password"
msgstr "كلمة المرور"

msgid "Business Name"
msgstr "اسم النشاط التجاري"

msgid "Your Booking Page Link (e.g., bookslot.app/your-name)"
msgstr "رابط صفحة الحجز الخاصة بك (مثال: bookslot.app/your-name)"

msgid "Lowercase letters, numbers, and hyphens only."
msgstr "أحرف صغيرة وأرقام وواصلات فقط."

msgid "Sign Up"
msgstr "التسجيل"

msgid "Already have an account?"
msgstr "هل لديك حساب بالفعل؟"

msgid "Log In"
msgstr "تسجيل الدخول"

msgid "Log In to BookSlot"
msgstr "تسجيل الدخول إلى BookSlot"

msgid "Account created successfully! Please log in."
msgstr "تم إنشاء الحساب بنجاح! يرجى تسجيل الدخول."

msgid "Invalid email or password."
msgstr "بريد إلكتروني أو كلمة مرور غير صحيحة."

msgid "Don't have an account?"
msgstr "ليس لديك حساب؟"

msgid "Logout"
msgstr "تسجيل الخروج"

msgid "Owner Dashboard"
msgstr "لوحة تحكم المالك"

msgid "Welcome, %s!"
msgstr "مرحباً، %s!"

msgid "Your booking page link:"
msgstr "رابط صفحة الحجز الخاصة بك:"

msgid "Profile updated successfully!"
msgstr "تم تحديث الملف الشخصي بنجاح!"

msgid "Error updating profile: "
msgstr "خطأ في تحديث الملف الشخصي: "

msgid "Your Profile"
msgstr "ملفك الشخصي"

msgid "Phone Number (for WhatsApp notifications)"
msgstr "رقم الهاتف (لإشعارات واتساب)"

msgid "Your Services"
msgstr "خدماتك"

msgid "Service Name"
msgstr "اسم الخدمة"

msgid "Duration (minutes)"
msgstr "المدة (بالدقائق)"

msgid "Price (e.g., $50)"
msgstr "السعر (مثال: 50$)"

msgid "Remove"
msgstr "إزالة"

msgid "Add Service"
msgstr "إضافة خدمة"

msgid "Your Availability"
msgstr "توفرك"

msgid "Select Day"
msgstr "اختر اليوم"

msgid "Monday"
msgstr "الاثنين"

msgid "Tuesday"
msgstr "الثلاثاء"

msgid "Wednesday"
msgstr "الأربعاء"

msgid "Thursday"
msgstr "الخميس"

msgid "Friday"
msgstr "الجمعة"

msgid "Saturday"
msgstr "السبت"

msgid "Sunday"
msgstr "الأحد"

msgid "Add Availability Slot"
msgstr "إضافة فترة توفر"

msgid "Update Profile"
msgstr "تحديث الملف الشخصي"

msgid "Upcoming Bookings"
msgstr "الحجوزات القادمة"

msgid "No upcoming bookings."
msgstr "لا توجد حجوزات قادمة."

msgid "with"
msgstr "مع"

msgid "at"
msgstr "في"

msgid "Phone:"
msgstr "الهاتف:"

msgid "Book Your Appointment"
msgstr "احجز موعدك"

msgid "Book Your Appointment with %s"
msgstr "احجز موعدك مع %s"

msgid "Welcome! Please select a service and an available time slot."
msgstr "مرحباً! يرجى اختيار خدمة وفترة زمنية متاحة."

msgid "Booking page not found."
msgstr "صفحة الحجز غير موجودة."

msgid "Invalid booking time. Please choose a future slot."
msgstr "وقت حجز غير صالح. يرجى اختيار فترة مستقبلية."

msgid "Booking failed. Please try again later."
msgstr "فشل الحجز. يرجى المحاولة لاحقاً."

msgid "Select Service"
msgstr "اختر الخدمة"

msgid "Choose a service"
msgstr "اختر خدمة"

msgid "minutes"
msgstr "دقيقة"

msgid "Select Date"
msgstr "اختر التاريخ"

msgid "Select Time"
msgstr "اختر الوقت"

msgid "Choose a time slot"
msgstr "اختر فترة زمنية"

msgid "Book Now"
msgstr "احجز الآن"

msgid "Booking Confirmed!"
msgstr "تم تأكيد الحجز!"

msgid "Thank you for your booking with %s."
msgstr "شكراً لحجزك مع %s."

msgid "A confirmation email has been sent to you."
msgstr "تم إرسال رسالة تأكيد بالبريد الإلكتروني إليك."

msgid "Book another appointment"
msgstr "احجز موعداً آخر"

msgid "New Booking Received!"
msgstr "تم استلام حجز جديد!"

msgid "You have a new booking from %s for %s at %s."
msgstr "لديك حجز جديد من %s لـ %s في %s."

msgid "Customer Phone: %s."
msgstr "هاتف العميل: %s."

msgid "Your Booking with %s Confirmed!"
msgstr "تم تأكيد حجزك مع %s!"

msgid "Hi %s, your booking for %s with %s on %s is confirmed."
msgstr "مرحباً %s، تم تأكيد حجزك لـ %s مع %s في %s."

msgid "New booking for %s: %s for %s at %s. Customer Phone: %s"
msgstr "حجز جديد لـ %s: %s لـ %s في %s. هاتف العميل: %s"

msgid "All rights reserved."
msgstr "جميع الحقوق محفوظة."