msgid "BookSlot - Simple Booking Page"
msgstr "بوك سلوت - صفحة حجز بسيطة"

msgid "Your Dead-Simple Booking Page"
msgstr "صفحة الحجز البسيطة الخاصة بك"

msgid "Manage appointments without WhatsApp chaos."
msgstr "إدارة المواعيد بدون فوضى الواتساب."

msgid "Get Started Free"
msgstr "ابدأ مجاناً"

msgid "Sign Up"
msgstr "التسجيل"

msgid "Login"
msgstr "تسجيل الدخول"

msgid "Create Your Account"
msgstr "أنشئ حسابك"

msgid "Email already registered"
msgstr "البريد الإلكتروني مسجل بالفعل"

msgid "Your Name"
msgstr "اسمك"

msgid "Business Name"
msgstr "اسم العمل"

msgid "Email"
msgstr "البريد الإلكتروني"

msgid "Password"
msgstr "كلمة المرور"

msgid "Already have an account?"
msgstr "هل لديك حساب بالفعل؟"

msgid "Login here"
msgstr "سجل الدخول هنا"

msgid "Login to Your Dashboard"
msgstr "سجل الدخول إلى لوحة التحكم الخاصة بك"

msgid "Invalid email or password"
msgstr "بريد إلكتروني أو كلمة مرور غير صحيحة"

msgid "Don't have an account?"
msgstr "ليس لديك حساب؟"

msgid "Sign up here"
msgstr "سجل هنا"

msgid "Book an Appointment"
msgstr "احجز موعداً"

msgid "Book Your Service"
msgstr "احجز خدمتك"

msgid "Your Phone (WhatsApp preferred)"
msgstr "رقم هاتفك (يفضل واتساب)"

msgid "Select Service"
msgstr "اختر الخدمة"

msgid "minutes"
msgstr "دقائق"

msgid "Select Date"
msgstr "اختر التاريخ"

msgid "Select Time"
msgstr "اختر الوقت"

msgid "Book Now"
msgstr "احجز الآن"

msgid "Our Services"
msgstr "خدماتنا"

msgid "Availability"
msgstr "التوفر"

msgid "Please choose a time slot based on the owner's availability."
msgstr "الرجاء اختيار وقت متاح بناءً على توفر المالك."

msgid "Booking Confirmed!"
msgstr "تم تأكيد الحجز!"

msgid "Thank you,"
msgstr "شكراً لك،"

msgid "Your appointment for"
msgstr "موعدك لـ"

msgid "with"
msgstr "مع"

msgid "has been successfully booked."
msgstr "تم حجزه بنجاح."

msgid "You will receive a confirmation email shortly."
msgstr "ستتلقى رسالة تأكيد عبر البريد الإلكتروني قريباً."

msgid "Booking Details"
msgstr "تفاصيل الحجز"

msgid "Service"
msgstr "الخدمة"

msgid "Date & Time"
msgstr "التاريخ والوقت"

msgid "Business"
msgstr "العمل"

msgid "Business Contact"
msgstr "جهة اتصال العمل"

msgid "We look forward to seeing you!"
msgstr "نتطلع لرؤيتك!"

msgid "Book another appointment"
msgstr "احجز موعداً آخر"

msgid "BookSlot Dashboard"
msgstr "لوحة تحكم بوك سلوت"

msgid "Logout"
msgstr "تسجيل الخروج"

msgid "Welcome"
msgstr "أهلاً بك"

msgid "Your Public Booking Page Link"
msgstr "رابط صفحة الحجز العامة الخاصة بك"

msgid "Upcoming Bookings"
msgstr "الحجوزات القادمة"

msgid "No upcoming bookings."
msgstr "لا توجد حجوزات قادمة."

msgid "Update Your Profile"
msgstr "حدث ملفك الشخصي"

msgid "Phone Number (for WhatsApp notifications)"
msgstr "رقم الهاتف (لإشعارات واتساب)"

msgid "Services (JSON Array)"
msgstr "الخدمات (مصفوفة JSON)"

msgid "Example: [{ \"name\": \"Haircut\", \"duration\": 30, \"price\": \"$30\" }]"
msgstr "مثال: [{ \"الاسم\": \"قص شعر\", \"المدة\": 30, \"السعر\": \"$30\" }]"

msgid "Availability (JSON Object)"
msgstr "التوفر (كائن JSON)"

msgid "Example: { \"Monday\": [\"09:00\", \"17:00\"], \"Tuesday\": [\"10:00\", \"18:00\"] }"
msgstr "مثال: { \"الاثنين\": [\"09:00\", \"17:00\"], \"الثلاثاء\": [\"10:00\", \"18:00\"] }"

msgid "Update Profile"
msgstr "تحديث الملف الشخصي"

msgid "N/A"
msgstr "غير متاح"

msgid "New Booking Notification"
msgstr "إشعار حجز جديد"

msgid "Hello"
msgstr "مرحباً"

msgid "You have received a new booking through BookSlot:"
msgstr "لقد تلقيت حجزاً جديداً عبر بوك سلوت:"

msgid "Time"
msgstr "الوقت"

msgid "Customer Name"
msgstr "اسم العميل"

msgid "Customer Email"
msgstr "بريد العميل الإلكتروني"

msgid "Customer Phone"
msgstr "هاتف العميل"

msgid "Please log in to your dashboard to view all upcoming bookings."
msgstr "الرجاء تسجيل الدخول إلى لوحة التحكم الخاصة بك لعرض جميع الحجوزات القادمة."

msgid "Go to Dashboard"
msgstr "انتقل إلى لوحة التحكم"

msgid "The BookSlot Team"
msgstr "فريق بوك سلوت"

msgid "New Booking Received for %(service_name)s!"
msgstr "تم استلام حجز جديد لـ %(service_name)s!"

msgid "Hi %(customer_name)s, your booking for %(service_name)s with %(business_name)s is confirmed for %(booking_time_str)s. See you then!"
msgstr "مرحباً %(customer_name)s، تم تأكيد حجزك لـ %(service_name)s مع %(business_name)s في %(booking_time_str)s. نراك قريباً!"

msgid "Hello %(owner_name)s, you have a new booking for %(service_name)s at %(booking_time_str)s with %(customer_name)s (%(customer_phone)s)."
msgstr "مرحباً %(owner_name)s، لديك حجز جديد لـ %(service_name)s في %(booking_time_str)s مع %(customer_name)s (%(customer_phone)s)."
