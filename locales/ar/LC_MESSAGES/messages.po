msgstr "اختر الخدمة"

msgid "-- Please select a service --"
msgstr "-- الرجاء اختيار خدمة --"

msgid "min"
msgstr "دقيقة"

msgid "Select Date"
msgstr "اختر التاريخ"

msgid "Select Time"
msgstr "اختر الوقت"

msgid "-- Please select a time --"
msgstr "-- الرجاء اختيار وقت --"

msgid "Book Now"
msgstr "احجز الآن"

msgid "Owner not found."
msgstr "لم يتم العثور على المالك."

msgid "Selected time slot is not available."
msgstr "الفتحة الزمنية المختارة غير متاحة."

msgid "This slot is already booked. Please choose another time."
msgstr "هذا الموعد محجوز بالفعل. الرجاء اختيار وقت آخر."

msgid "New Booking for {service_name}!"
msgstr "حجز جديد لـ {service_name}!"

msgid "Dear {owner_name},"
msgstr "عزيزي {owner_name},"

msgid "You have a new booking!"
msgstr "لديك حجز جديد!"

msgid "Service: {service_name}"
msgstr "الخدمة: {service_name}"

msgid "Date: {booking_date}"
msgstr "التاريخ: {booking_date}"

msgid "Time: {booking_time}"
msgstr "الوقت: {booking_time}"

msgid "Customer Name: {customer_name}"
msgstr "اسم العميل: {customer_name}"

msgid "Customer Email: {customer_email}"
msgstr "بريد العميل الإلكتروني: {customer_email}"

msgid "Customer Phone: {customer_phone}"
msgstr "هاتف العميل: {customer_phone}"

msgid "BookSlot App"
msgstr "تطبيق بوك سلوت"

msgid "New booking for {service_name} on {booking_date} at {booking_time} with {customer_name}."
msgstr "حجز جديد لـ {service_name} بتاريخ {booking_date} في {booking_time} مع {customer_name}."

msgid "Your Booking for {service_name} is Confirmed!"
msgstr "تم تأكيد حجزك لـ {service_name}!"

msgid "Dear {customer_name},"
msgstr "عزيزي {customer_name},"

msgid "Your booking with {business_name} for {service_name} on {booking_date} at {booking_time} has been confirmed."
msgstr "تم تأكيد حجزك مع {business_name} لـ {service_name} بتاريخ {booking_date} في {booking_time}."

msgid "We look forward to seeing you!"
msgstr "نتطلع لرؤيتك!"

msgid "Your booking with {business_name} for {service_name} on {booking_date} at {booking_time} is confirmed."
msgstr "تم تأكيد حجزك مع {business_name} لـ {service_name} بتاريخ {booking_date} في {booking_time}."

msgid "Booking confirmed successfully!"
msgstr "تم تأكيد الحجز بنجاح!"

msgid "Failed to create booking."
msgstr "فشل في إنشاء الحجز."

msgid "Booking Confirmed!"
msgstr "تم تأكيد الحجز!"

msgid "You will receive an email confirmation shortly."
msgstr "ستتلقى تأكيدًا عبر البريد الإلكتروني قريبًا."

msgid "Go to homepage"
msgstr "اذهب إلى الصفحة الرئيسية"

msgid "No availability for this day."
msgstr "لا يوجد توفر لهذا اليوم."

msgid "Invalid JSON format for services or availability."
msgstr "تنسيق JSON غير صالح للخدمات أو التوفر."

msgid "An unexpected error occurred during booking."
msgstr "حدث خطأ غير متوقع أثناء الحجز."
