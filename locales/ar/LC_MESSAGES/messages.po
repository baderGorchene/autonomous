msgid "BookSlot"
msgstr "بوك سلوت"

msgid "Dashboard"
msgstr "لوحة التحكم"

msgid "Logout"
msgstr "تسجيل الخروج"

msgid "Login"
msgstr "تسجيل الدخول"

msgid "Sign Up"
msgstr "التسجيل"

msgid "Incorrect email or password"
msgstr "البريد الإلكتروني أو كلمة المرور غير صحيحة"

msgid "Logged in successfully!"
msgstr "تم تسجيل الدخول بنجاح!"

msgid "You have been logged out."
msgstr "تم تسجيل خروجك."

msgid "Login to your BookSlot account"
msgstr "تسجيل الدخول إلى حسابك في بوك سلوت"

msgid "Email address"
msgstr "عنوان البريد الإلكتروني"

msgid "Password"
msgstr "كلمة المرور"

msgid "Don't have an account?"
msgstr "ليس لديك حساب؟"

msgid "Create your BookSlot account"
msgstr "إنشاء حسابك في بوك سلوت"

msgid "Your Name"
msgstr "اسمك"

msgid "Business Name"
msgstr "اسم النشاط التجاري"

msgid "Your Public Booking URL (e.g., bookslot.app/your-name)"
msgstr "رابط صفحة الحجز العامة الخاصة بك (مثال: bookslot.app/your-name)"

msgid "Lowercase alphanumeric with hyphens only"
msgstr "أحرف وأرقام صغيرة مع واصلات فقط"

msgid "This will be your unique booking page URL."
msgstr "سيكون هذا هو رابط صفحة الحجز الفريد الخاص بك."

msgid "Email already registered"
msgstr "البريد الإلكتروني مسجل بالفعل"

msgid "Business URL (slug) already taken"
msgstr "عنوان URL للنشاط التجاري (slug) مستخدم بالفعل"

msgid "Account created successfully! Welcome to BookSlot."
msgstr "تم إنشاء الحساب بنجاح! مرحباً بك في بوك سلوت."

msgid "An error occurred during signup: %s"
msgstr "حدث خطأ أثناء التسجيل: %s"

msgid "Already have an account?"
msgstr "هل لديك حساب بالفعل؟"

msgid "Welcome, %s!"
msgstr "مرحباً، %s!"

msgid "Your Public Booking Page"
msgstr "صفحة الحجز العامة الخاصة بك"

msgid "Share this link with your customers to let them book appointments easily:"
msgstr "شارك هذا الرابط مع عملائك لتمكينهم من حجز المواعيد بسهولة:"

msgid "Copy Link"
msgstr "نسخ الرابط"

msgid "Upcoming Bookings"
msgstr "الحجوزات القادمة"

msgid "with"
msgstr "مع"

msgid "Date:"
msgstr "التاريخ:"

msgid "at"
msgstr "في"

msgid "Customer Email:"
msgstr "البريد الإلكتروني للعميل:"

msgid "Customer Phone:"
msgstr "هاتف العميل:"

msgid "N/A"
msgstr "غير متوفر"

msgid "No upcoming bookings yet."
msgstr "لا توجد حجوزات قادمة بعد."

msgid "Your Profile and Settings"
msgstr "ملفك الشخصي والإعدادات"

msgid "Manage your services, availability, and contact information."
msgstr "إدارة خدماتك وتوافرك ومعلومات الاتصال الخاصة بك."

msgid "Edit Profile"
msgstr "تعديل الملف الشخصي"

msgid "Profile Settings"
msgstr "إعدادات الملف الشخصي"

msgid "Basic Information"
msgstr "المعلومات الأساسية"

msgid "Phone Number (for WhatsApp notifications)"
msgstr "رقم الهاتف (لإشعارات الواتساب)"

msgid "Include country code, e.g., +1234567890"
msgstr "تضمين رمز البلد، مثال: +1234567890"

msgid "Email Address"
msgstr "عنوان البريد الإلكتروني"

msgid "Public Booking URL Slug"
msgstr "عنوان URL المختصر لصفحة الحجز العامة"

msgid "This is your unique booking page URL and cannot be changed."
msgstr "هذا هو رابط صفحة الحجز الفريد الخاص بك ولا يمكن تغييره."

msgid "Your Services"
msgstr "خدماتك"

msgid "Add Service"
msgstr "إضافة خدمة"

msgid "Service Name"
msgstr "اسم الخدمة"

msgid "Description"
msgstr "الوصف"

msgid "Duration (minutes)"
msgstr "المدة (بالدقائق)"

msgid "Price"
msgstr "السعر"

msgid "Remove"
msgstr "إزالة"

msgid "Your Availability"
msgstr "توافرك"

msgid "Add Availability Slot"
msgstr "إضافة فترة توفر"

msgid "Day of Week"
msgstr "يوم الأسبوع"

msgid "Monday"
msgstr "الاثنين"

msgid "Tuesday"
msgstr "الثلاثاء"

msgid "Wednesday"
msgstr "الأربعاء"

msgid "Thursday"
msgstr "الخميس"

msgid "Friday"
msgstr "الجمعة"

msgid "Saturday"
msgstr "السبت"

msgid "Sunday"
msgstr "الأحد"

msgid "Start Time"
msgstr "وقت البدء"

msgid "End Time"
msgstr "وقت الانتهاء"

msgid "Save Changes"
msgstr "حفظ التغييرات"

msgid "Profile updated successfully!"
msgstr "تم تحديث الملف الشخصي بنجاح!"

msgid "Invalid JSON format for services or availability."
msgstr "تنسيق JSON غير صالح للخدمات أو التوافر."

msgid "Error updating profile: %s"
msgstr "خطأ أثناء تحديث الملف الشخصي: %s"

msgid "Owner not found"
msgstr "لم يتم العثور على المالك"

msgid "Book an Appointment"
msgstr "احجز موعداً"

msgid "Book your appointment with %s."
msgstr "احجز موعدك مع %s."

msgid "Select a Service"
msgstr "اختر خدمة"

msgid "Choose a service..."
msgstr "اختر خدمة..."

msgid "min"
msgstr "دقيقة"

msgid "Select Date"
msgstr "اختر التاريخ"

msgid "Select Time Slot"
msgstr "اختر فترة زمنية"

msgid "Please select a date to see available time slots."
msgstr "يرجى اختيار تاريخ لعرض الفترات الزمنية المتاحة."

msgid "Book Now"
msgstr "احجز الآن"

msgid "Cannot book a date in the past."
msgstr "لا يمكن حجز تاريخ في الماضي."

msgid "New Booking for %s"
msgstr "حجز جديد لـ %s"

msgid "Your Booking Confirmation with %s"
msgstr "تأكيد حجزك مع %s"

msgid "Booking confirmed! A confirmation email has been sent."
msgstr "تم تأكيد الحجز! تم إرسال بريد إلكتروني للتأكيد."

msgid "Invalid date or time format."
msgstr "تنسيق التاريخ أو الوقت غير صالح."

msgid "An error occurred during booking: %s"
msgstr "حدث خطأ أثناء الحجز: %s"

msgid "Booking Confirmed!"
msgstr "تم تأكيد الحجز!"

msgid "Thank you for booking with %s."
msgstr "شكراً لك على الحجز مع %s."

msgid "A confirmation email has been sent to your inbox."
msgstr "تم إرسال بريد إلكتروني للتأكيد إلى بريدك الوارد."

msgid "We look forward to seeing you!"
msgstr "نتطلع لرؤيتك!"

msgid "Book another appointment"
msgstr "احجز موعداً آخر"

msgid "Please select a service and a date."
msgstr "الرجاء اختيار خدمة وتاريخ."

msgid "No availability for this day."
msgstr "لا توجد إتاحة لهذا اليوم."

msgid "No available time slots for the selected service and date."
msgstr "لا توجد فترات زمنية متاحة للخدمة والتاريخ المحددين."
