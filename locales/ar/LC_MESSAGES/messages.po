msgstr "حفظ الخدمات"

msgid "Service Name"
msgstr "اسم الخدمة"

msgid "Description"
msgstr "الوصف"

msgid "Duration (minutes)"
msgstr "المدة (بالدقائق)"

msgid "Price"
msgstr "السعر"

