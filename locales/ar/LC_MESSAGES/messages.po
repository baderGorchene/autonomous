msgstr "عنوان البريد الإلكتروني"

msgid "Password"
msgstr "كلمة المرور"

msgid "Business Name"
msgstr "اسم العمل"

msgid "Your Booking Page URL Slug (e.g., bookslot.app/your-slug)"
msgstr "عنوان URL لصفحة الحجز الخاصة بك (مثال: bookslot.app/your-slug)"

msgid "Slug must be lowercase alphanumeric, separated by hyphens."
msgstr "يجب أن يكون العنوان صغيرًا وأبجديًا رقميًا، مفصولًا بالواصلات."

msgid "Don't have an account?"
msgstr "ليس لديك حساب؟"

msgid "Login to BookSlot"
msgstr "تسجيل الدخول إلى بوك سلوت"

