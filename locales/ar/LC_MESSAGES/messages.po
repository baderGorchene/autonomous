msgstr "تنسيق JSON غير صالح للتوافر."

msgid "Error updating availability: {e}"
msgstr "خطأ في تحديث التوفر: {e}"

msgid "Book an Appointment"
msgstr "احجز موعدا"

msgid "Book your appointment quickly and easily."
msgstr "احجز موعدك بسرعة وسهولة."

msgid "Your Email"
msgstr "بريدك الإلكتروني"

msgid "Select Service"
msgstr "اختر الخدمة"

msgid "Choose a service..."
msgstr "اختر خدمة..."

msgid "Select Date"
msgstr "اختر التاريخ"

msgid "Select Time"
msgstr "اختر الوقت"

msgid "Choose a time..."
msgstr "اختر وقتا..."

msgid "Book Now"
msgstr "احجز الآن"

msgid "Booking time must be in the future."
msgstr "يجب أن يكون وقت الحجز في المستقبل."

msgid "New Booking Received!"
msgstr "تم استلام حجز جديد!"

msgid "Dear {owner.name},<br><br>You have received a new booking:<br>Customer: {customer_name}<br>Email: {customer_email}<br>Phone: {customer_phone or 'N/A'}<br>Service: {service_name}<br>Time: {booking_datetime.strftime('%Y-%m-%d %H:%M')}<br><br>Thank you.<br>BookSlot"
msgstr "عزيزي {owner.name}،<br><br>لقد تلقيت حجزًا جديدًا:<br>العميل: {customer_name}<br>البريد الإلكتروني: {customer_email}<br>الهاتف: {customer_phone or 'N/A'}<br>الخدمة: {service_name}<br>الوقت: {booking_datetime.strftime('%Y-%m-%d %H:%M')}<br><br>شكراً لك.<br>بوك سلوت"

msgid "BookSlot: New booking for {service_name} at {booking_datetime.strftime('%H:%M')} on {booking_datetime.strftime('%Y-%m-%d')}. Customer: {customer_name}."
msgstr "بوك سلوت: حجز جديد لـ {service_name} في {booking_datetime.strftime('%H:%M')} بتاريخ {booking_datetime.strftime('%Y-%m-%d')}. العميل: {customer_name}."

msgid "Your Booking Confirmation"
msgstr "تأكيد حجزك"

msgid "Dear {customer_name},<br><br>Your booking for {service_name} with {owner.business_name} on {booking_datetime.strftime('%Y-%m-%d')} at {booking_datetime.strftime('%H:%M')} has been confirmed.<br><br>Thank you for using BookSlot.<br>"
msgstr "عزيزي {customer_name}،<br><br>تم تأكيد حجزك لـ {service_name} مع {owner.business_name} بتاريخ {booking_datetime.strftime('%Y-%m-%d')} في {booking_datetime.strftime('%H:%M')}.<br><br>شكراً لاستخدامك بوك سلوت.<br>"

msgid "Your booking with {owner.business_name} for {service_name} on {booking_datetime.strftime('%Y-%m-%d')} at {booking_datetime.strftime('%H:%M')} is confirmed. BookSlot"
msgstr "تم تأكيد حجزك مع {owner.business_name} لـ {service_name} بتاريخ {booking_datetime.strftime('%Y-%m-%d')} في {booking_datetime.strftime('%H:%M')}. بوك سلوت"

msgid "Booking successful!"
msgstr "تم الحجز بنجاح!"

msgid "Invalid date or time format."
msgstr "تنسيق التاريخ أو الوقت غير صالح."

msgid "An error occurred during booking: {e}"
msgstr "حدث خطأ أثناء الحجز: {e}"

msgid "Booking Confirmed!"
msgstr "تم تأكيد الحجز!"

msgid "Thank you,"
msgstr "شكراً لك،"

msgid "Your appointment with"
msgstr "موعدك مع"

msgid "for"
msgstr "لـ"

msgid "on"
msgstr "في"

msgid "at"
msgstr "في تمام"

msgid "has been successfully booked."
msgstr "تم حجزه بنجاح."

msgid "A confirmation email has been sent to"
msgstr "تم إرسال بريد إلكتروني للتأكيد إلى"

msgid "You may also receive a WhatsApp notification."
msgstr "قد تتلقى أيضًا إشعارًا عبر واتساب."

msgid "Book Another Appointment"
msgstr "احجز موعدًا آخر"

msgid "All rights reserved."
msgstr "جميع الحقوق محفوظة."

