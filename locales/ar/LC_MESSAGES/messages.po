msgid "Sign Up"
msgstr "التسجيل"

msgid "Create Your BookSlot Account"
msgstr "إنشاء حسابك في BookSlot"

msgid "Your Name"
msgstr "اسمك"

msgid "Email"
msgstr "البريد الإلكتروني"

msgid "Password"
msgstr "كلمة المرور"

msgid "Business Name"
msgstr "اسم النشاط التجاري"

msgid "Public Booking Page URL Slug"
msgstr "عنوان URL الخاص بصفحة الحجز العامة"

msgid "Lowercase letters, numbers, and hyphens only. Min 3, max 50 characters."
msgstr "أحرف صغيرة، أرقام، وواصلات فقط. 3 أحرف كحد أدنى، 50 كحد أقصى."

msgid "Phone Number (for WhatsApp notifications, optional)"
msgstr "رقم الهاتف (لإشعارات واتساب، اختياري)"

msgid "Already have an account?"
msgstr "هل لديك حساب بالفعل؟"

msgid "Log In"
msgstr "تسجيل الدخول"

msgid "Login"
msgstr "تسجيل الدخول"

msgid "Login to BookSlot"
msgstr "تسجيل الدخول إلى BookSlot"

msgid "Don't have an account?"
msgstr "ليس لديك حساب؟"

msgid "Email already registered."
msgstr "البريد الإلكتروني مسجل بالفعل."

msgid "Business URL slug already taken."
msgstr "عنوان URL الخاص بالنشاط التجاري مستخدم بالفعل."

msgid "An unexpected error occurred during signup."
msgstr "حدث خطأ غير متوقع أثناء التسجيل."

msgid "Incorrect email or password."
msgstr "بريد إلكتروني أو كلمة مرور غير صحيحة."

msgid "Dashboard"
msgstr "لوحة التحكم"

msgid "Welcome"
msgstr "أهلاً بك"

msgid "Your Public Booking Page"
msgstr "صفحة الحجز العامة الخاصة بك"

msgid "Upcoming Bookings"
msgstr "الحجوزات القادمة"

msgid "No upcoming bookings."
msgstr "لا توجد حجوزات قادمة."

msgid "Manage Your Profile"
msgstr "إدارة ملفك الشخصي"

msgid "Services (JSON format)"
msgstr "الخدمات (بصيغة JSON)"

msgid "Example: [{\"name\": \"Haircut\", \"duration\": 30}, {\"name\": \"Shave\", \"duration\": 15}]"
msgstr "مثال: [{\"قص شعر\": \"Haircut\", \"duration\": 30}, {\"حلاقة\": \"Shave\", \"duration\": 15}]"

msgid "Availability (JSON format)"
msgstr "التوفر (بصيغة JSON)"

msgid "Example: {\"monday\": [{\"start\": \"09:00\", \"end\": \"17:00\"}], \"tuesday\": [{\"start\": \"10:00\", \"end\": \"18:00\"}]}"
msgstr "مثال: {\"الاثنين\": [{\"البداية\": \"09:00\", \"النهاية\": \"17:00\"}], \"الثلاثاء\": [{\"البداية\": \"10:00\", \"النهاية\": \"18:00\"}]}"

msgid "Update Profile"
msgstr "تحديث الملف الشخصي"

msgid "Profile updated successfully!"
msgstr "تم تحديث الملف الشخصي بنجاح!"

msgid "Invalid JSON format for services or availability."
msgstr "صيغة JSON غير صالحة للخدمات أو التوفر."

msgid "Services must be a list."
msgstr "يجب أن تكون الخدمات قائمة."

msgid "Each service must have 'name' and 'duration'."
msgstr "يجب أن تحتوي كل خدمة على 'اسم' و 'مدة'."

msgid "Availability must be a dictionary."
msgstr "يجب أن يكون التوفر قاموسًا."

msgid "Availability for {day} must be a list of slots."
msgstr "يجب أن يكون التوفر لـ {day} قائمة من الفترات."

msgid "Each slot for {day} must have 'start' and 'end' times."
msgstr "يجب أن تحتوي كل فترة لـ {day} على أوقات 'البداية' و 'النهاية'."

msgid "An unexpected error occurred during profile update."
msgstr "حدث خطأ غير متوقع أثناء تحديث الملف الشخصي."

msgid "Book a Service"
msgstr "احجز خدمة"

msgid "Welcome! Book your service below."
msgstr "أهلاً بك! احجز خدمتك أدناه."

msgid "Select Service"
msgstr "اختر الخدمة"

msgid "-- Choose a service --"
msgstr "-- اختر خدمة --"

msgid "min"
msgstr "دقيقة"

msgid "Select Date"
msgstr "اختر التاريخ"

msgid "Select Time"
msgstr "اختر الوقت"

msgid "Book Now"
msgstr "احجز الآن"

msgid "Invalid date format."
msgstr "تنسيق تاريخ غير صالح."

msgid "Owner is not available on this day."
msgstr "المالك غير متاح في هذا اليوم."

msgid "The selected time is not available or conflicts with existing bookings."
msgstr "الوقت المحدد غير متاح أو يتعارض مع الحجوزات الحالية."

msgid "An unexpected error occurred during booking. Please try again."
msgstr "حدث خطأ غير متوقع أثناء الحجز. يرجى المحاولة مرة أخرى."

msgid "Booking Confirmed!"
msgstr "تم تأكيد الحجز!"

msgid "Thank you for your booking with"
msgstr "شكراً لحجزك مع"

msgid "You will receive a confirmation email shortly."
msgstr "ستتلقى رسالة تأكيد بالبريد الإلكتروني قريباً."

msgid "Book another service"
msgstr "احجز خدمة أخرى"

msgid "Your Booking Confirmation"
msgstr "تأكيد حجزك"

msgid "Dear"
msgstr "عزيزي"

msgid "Your booking with {} is confirmed!"
msgstr "تم تأكيد حجزك مع {}!"

msgid "Your booking with"
msgstr "حجزك مع"

msgid "is confirmed."
msgstr "تم تأكيده."

msgid "Service"
msgstr "الخدمة"

msgid "Date"
msgstr "التاريخ"

msgid "Time"
msgstr "الوقت"

msgid "We look forward to seeing you!"
msgstr "نتطلع لرؤيتك!"

msgid "Regards,"
msgstr "مع خالص التقدير،"

msgid "New Booking Notification"
msgstr "إشعار حجز جديد"

msgid "New booking received for {}!"
msgstr "تم استلام حجز جديد لـ {}!"

msgid "New Booking Received!"
msgstr "تم استلام حجز جديد!"

msgid "You have a new booking:"
msgstr "لديك حجز جديد:"

msgid "Customer Name"
msgstr "اسم العميل"

msgid "Customer Email"
msgstr "بريد العميل الإلكتروني"

msgid "Customer Phone"
msgstr "رقم هاتف العميل"

msgid "N/A"
msgstr "غير متوفر"

msgid "Check your dashboard for more details."
msgstr "تحقق من لوحة التحكم الخاصة بك لمزيد من التفاصيل."

msgid "New booking for {service_name} on {date} at {time} by {customer_name}. Customer phone: {customer_phone}"
msgstr "حجز جديد لـ {service_name} في {date} الساعة {time} بواسطة {customer_name}. هاتف العميل: {customer_phone}"
