msgid "Login to BookSlot"
msgstr "تسجيل الدخول إلى BookSlot"

msgid "Email address"
msgstr "عنوان البريد الإلكتروني"

msgid "Password"
msgstr "كلمة المرور"

msgid "Login"
msgstr "تسجيل الدخول"

msgid "Don't have an account?"
msgstr "ليس لديك حساب؟"

msgid "Sign up here"
msgstr "سجل هنا"

msgid "Incorrect email or password"
msgstr "بريد إلكتروني أو كلمة مرور غير صحيحة"

msgid "Sign Up for BookSlot"
msgstr "التسجيل في BookSlot"

msgid "Your Name"
msgstr "اسمك"

msgid "Your Business Name"
msgstr "اسم عملك"

msgid "Custom URL Slug (e.g., bookslot.app/your-slug)"
msgstr "اسم الرابط المخصص (مثال: bookslot.app/اسمك-المخصص)"

msgid "Only lowercase letters, numbers, and hyphens"
msgstr "فقط أحرف صغيرة وأرقام وواصلات"

msgid "Phone Number (Optional, for WhatsApp notifications)"
msgstr "رقم الهاتف (اختياري، لإشعارات واتساب)"

msgid "Sign Up"
msgstr "التسجيل"

msgid "Already have an account?"
msgstr "هل لديك حساب بالفعل؟"

msgid "Email already registered"
msgstr "البريد الإلكتروني مسجل بالفعل"

msgid "Custom URL already taken"
msgstr "الرابط المخصص مأخوذ بالفعل"

msgid "An error occurred during signup. Please try again."
msgstr "حدث خطأ أثناء التسجيل. يرجى المحاولة مرة أخرى."

msgid "Welcome, %s!"
msgstr "أهلاً بك، %s!"

msgid "Dashboard"
msgstr "لوحة التحكم"

msgid "Profile"
msgstr "الملف الشخصي"

msgid "Services & Availability"
msgstr "الخدمات والتوافر"

msgid "My Booking Page"
msgstr "صفحة حجوزاتي"

msgid "Logout"
msgstr "تسجيل الخروج"

msgid "Upcoming Bookings"
msgstr "الحجوزات القادمة"

msgid "Date"
msgstr "التاريخ"

msgid "Time"
msgstr "الوقت"

msgid "Service"
msgstr "الخدمة"

msgid "Customer Name"
msgstr "اسم العميل"

msgid "Customer Email"
msgstr "بريد العميل الإلكتروني"

msgid "Customer Phone"
msgstr "هاتف العميل"

msgid "Status"
msgstr "الحالة"

msgid "N/A"
msgstr "غير متوفر"

msgid "No upcoming bookings."
msgstr "لا توجد حجوزات قادمة."

msgid "Your Profile"
msgstr "ملفك الشخصي"

msgid "Phone Number (for WhatsApp notifications)"
msgstr "رقم الهاتف (لإشعارات واتساب)"

msgid "Custom URL Slug"
msgstr "اسم الرابط المخصص"

msgid "Update Profile"
msgstr "تحديث الملف الشخصي"

msgid "Profile updated successfully!"
msgstr "تم تحديث الملف الشخصي بنجاح!"

msgid "An error occurred during profile update. Please try again."
msgstr "حدث خطأ أثناء تحديث الملف الشخصي. يرجى المحاولة مرة أخرى."

msgid "Setup Your Services & Availability"
msgstr "إعداد خدماتك وتوافرك"

msgid "Manage Your Services"
msgstr "إدارة خدماتك"

msgid "Service Name"
msgstr "اسم الخدمة"

msgid "Duration (minutes)"
msgstr "المدة (بالدقائق)"

msgid "Price"
msgstr "السعر"

msgid "Description (Optional)"
msgstr "الوصف (اختياري)"

msgid "Remove Service"
msgstr "إزالة الخدمة"

msgid "No services added yet."
msgstr "لم تتم إضافة خدمات بعد."

msgid "Add New Service"
msgstr "إضافة خدمة جديدة"

msgid "Save Services"
msgstr "حفظ الخدمات"

msgid "Invalid JSON format for services data."
msgstr "تنسيق JSON غير صالح لبيانات الخدمات."

msgid "An error occurred during service update. Please try again."
msgstr "حدث خطأ أثناء تحديث الخدمة. يرجى المحاولة مرة أخرى."

msgid "Set Your Availability"
msgstr "حدد توافرك"

msgid "Choose your available days and time slots."
msgstr "اختر أيامك وأوقاتك المتاحة."

msgid "Monday"
msgstr "الاثنين"

msgid "Tuesday"
msgstr "الثلاثاء"

msgid "Wednesday"
msgstr "الأربعاء"

msgid "Thursday"
msgstr "الخميس"

msgid "Friday"
msgstr "الجمعة"

msgid "Saturday"
msgstr "السبت"

msgid "Sunday"
msgstr "الأحد"

msgid "Remove"
msgstr "إزالة"

msgid "Add Slot"
msgstr "إضافة وقت"

msgid "Save Availability"
msgstr "حفظ التوافر"

msgid "Invalid JSON format for availability data."
msgstr "تنسيق JSON غير صالح لبيانات التوافر."

msgid "An error occurred during availability update. Please try again."
msgstr "حدث خطأ أثناء تحديث التوافر. يرجى المحاولة مرة أخرى."

msgid "Book an Appointment with %s"
msgstr "احجز موعدًا مع %s"

msgid "1. Choose a Service"
msgstr "1. اختر خدمة"

msgid "Duration: %s minutes"
msgstr "المدة: %s دقيقة"

msgid "Price: %s"
msgstr "السعر: %s"

msgid "No services available yet. Please check back later."
msgstr "لا توجد خدمات متاحة بعد. يرجى التحقق لاحقًا."

msgid "2. Select a Date"
msgstr "2. اختر تاريخًا"

msgid "Select Date"
msgstr "اختر التاريخ"

msgid "3. Choose a Time Slot"
msgstr "3. اختر وقتًا"

msgid "Please select a date to see available times."
msgstr "يرجى اختيار تاريخ لعرض الأوقات المتاحة."

msgid "4. Your Details"
msgstr "4. تفاصيلك"

msgid "Your Email"
msgstr "بريدك الإلكتروني"

msgid "Confirm Booking"
msgstr "تأكيد الحجز"

msgid "Booking Confirmed!"
msgstr "تم تأكيد الحجز!"

msgid "Thank you for your booking!"
msgstr "شكراً لك على حجزك!"

msgid "Your appointment with %s for %s on %s at %s has been successfully confirmed."
msgstr "تم تأكيد موعدك مع %s لـ %s في %s الساعة %s بنجاح."

msgid "A confirmation email has been sent to %s."
msgstr "تم إرسال بريد إلكتروني للتأكيد إلى %s."

msgid "We look forward to seeing you!"
msgstr "نتطلع إلى رؤيتك!"

msgid "Book another appointment"
msgstr "احجز موعدًا آخر"

msgid "Go to Homepage"
msgstr "الذهاب إلى الصفحة الرئيسية"

msgid "Invalid date format. Please use YYYY-MM-DD."
msgstr "تنسيق تاريخ غير صالح. يرجى استخدام YYYY-MM-DD."

msgid "An error occurred during booking. Please try again."
msgstr "حدث خطأ أثناء الحجز. يرجى المحاولة مرة أخرى."

msgid "No availability for this day."
msgstr "لا يوجد توافر لهذا اليوم."
