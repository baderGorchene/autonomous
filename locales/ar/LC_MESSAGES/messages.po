msgid "2023 BookSlot. All rights reserved."
msgstr "2023 بوك سلوت. جميع الحقوق محفوظة."

msgid "Welcome to BookSlot"
msgstr "مرحباً بك في بوك سلوت"

msgid "Effortless Booking for Your Business"
msgstr "حجوزات سهلة لعملك"

msgid "Say goodbye to WhatsApp chaos. Get your simple, shareable booking page today!"
msgstr "وداعاً لفوضى واتساب. احصل على صفحة حجزك البسيطة والقابلة للمشاركة اليوم!"

msgid "Get Started - It's Free!"
msgstr "ابدأ الآن - إنه مجاني!"

msgid "Free for up to 20 bookings/month, then just $19/month."
msgstr "مجاني حتى 20 حجزًا شهريًا، ثم 19 دولارًا شهريًا فقط."

msgid "Login to BookSlot"
msgstr "تسجيل الدخول إلى بوك سلوت"

msgid "Login"
msgstr "تسجيل الدخول"

msgid "Email"
msgstr "البريد الإلكتروني"

msgid "Password"
msgstr "كلمة المرور"

msgid "Don't have an account?"
msgstr "ليس لديك حساب؟"

msgid "Sign Up"
msgstr "سجل الآن"

msgid "Sign Up for BookSlot"
msgstr "سجل في بوك سلوت"

msgid "Your Name"
msgstr "اسمك"

msgid "Business Name"
msgstr "اسم العمل"

msgid "Your Booking Page URL (e.g., your-name)"
msgstr "رابط صفحة الحجز الخاصة بك (مثلاً: your-name)"

msgid "Lowercase letters, numbers, and hyphens only."
msgstr "أحرف صغيرة وأرقام وواصلات فقط."

msgid "This will be your unique public booking page link."
msgstr "هذا سيكون رابط صفحة الحجز العامة الفريد الخاص بك."

msgid "Phone Number (e.g., +1234567890 for WhatsApp notifications)"
msgstr "رقم الهاتف (مثلاً: +1234567890 لإشعارات واتساب)"

msgid "Create Account"
msgstr "إنشاء حساب"

msgid "Already have an account?"
msgstr "هل لديك حساب بالفعل؟"

msgid "Dashboard"
msgstr "لوحة التحكم"

msgid "Logout"
msgstr "تسجيل الخروج"

msgid "Welcome,"
msgstr "أهلاً بك،"

msgid "Your Booking Page"
msgstr "صفحة الحجز الخاصة بك"

msgid "Share this link with your customers:"
msgstr "شارك هذا الرابط مع عملائك:"

msgid "Upcoming Bookings"
msgstr "الحجوزات القادمة"

msgid "Customer:"
msgstr "العميل:"

msgid "Phone:"
msgstr "الهاتف:"

msgid "N/A"
msgstr "غير متوفر"

msgid "No upcoming bookings."
msgstr "لا توجد حجوزات قادمة."

msgid "Your Profile, Services & Availability"
msgstr "ملفك الشخصي، الخدمات والتوافر"

msgid "Business Information"
msgstr "معلومات العمل"

msgid "Phone Number (for WhatsApp notifications)"
msgstr "رقم الهاتف (لإشعارات واتساب)"

msgid "Services Offered"
msgstr "الخدمات المقدمة"

msgid "Service Name"
msgstr "اسم الخدمة"

msgid "Duration (min)"
msgstr "المدة (دقيقة)"

msgid "Price"
msgstr "السعر"

msgid "Add Service"
msgstr "إضافة خدمة"

msgid "Your Availability"
msgstr "توافرك"

msgid "Start Time"
msgstr "وقت البدء"

msgid "End Time"
msgstr "وقت الانتهاء"

msgid "Add Slot"
msgstr "إضافة فترة"

msgid "Days not listed are considered unavailable."
msgstr "الأيام غير المدرجة تعتبر غير متاحة."

msgid "Save Changes"
msgstr "حفظ التغييرات"

msgid "Authentication token not found. Please log in again."
msgstr "لم يتم العثور على رمز المصادقة. يرجى تسجيل الدخول مرة أخرى."

msgid "Profile updated successfully!"
msgstr "تم تحديث الملف الشخصي بنجاح!"

msgid "Failed to update profile."
msgstr "فشل تحديث الملف الشخصي."

msgid "Book Now"
msgstr "احجز الآن"

msgid "Book your appointment quickly and easily!"
msgstr "احجز موعدك بسرعة وسهولة!"

msgid "Error!"
msgstr "خطأ!"

msgid "Success!"
msgstr "نجاح!"

msgid "1. Select a Service"
msgstr "1. اختر خدمة"

msgid "No description provided."
msgstr "لا يوجد وصف متاح."

msgid "min"
msgstr "دقيقة"

msgid "Please select a service."
msgstr "الرجاء اختيار خدمة."

msgid "2. Select a Date"
msgstr "2. اختر تاريخاً"

msgid "No available slots for this date."
msgstr "لا توجد فترات متاحة لهذا التاريخ."

msgid "Please select a date."
msgstr "الرجاء اختيار تاريخ."

msgid "3. Select a Time Slot"
msgstr "3. اختر فترة زمنية"

msgid "Please select a time slot."
msgstr "الرجاء اختيار فترة زمنية."

msgid "4. Your Details"
msgstr "4. تفاصيلك"

msgid "Your Email"
msgstr "بريدك الإلكتروني"

msgid "Your Phone Number (Optional, for WhatsApp updates)"
msgstr "رقم هاتفك (اختياري، لتلقي تحديثات واتساب)"

msgid "Confirm Booking"
msgstr "تأكيد الحجز"

msgid "Booking Confirmed!"
msgstr "تم تأكيد الحجز!"

msgid "Thank you for your booking."
msgstr "شكراً لحجزك."

msgid "You will receive a confirmation email shortly."
msgstr "ستتلقى رسالة تأكيد عبر البريد الإلكتروني قريباً."

msgid "Go to Home"
msgstr "الذهاب إلى الصفحة الرئيسية"
