msgid "BookSlot - Simple Booking Page"
msgstr "بوك سلوت - صفحة حجز بسيطة"

msgid "Welcome to BookSlot"
msgstr "مرحباً بك في بوك سلوت"

msgid "Your dead-simple booking page for local service businesses."
msgstr "صفحة الحجز البسيطة لشركات الخدمات المحلية."

msgid "Sign Up"
msgstr "التسجيل"

msgid "Login"
msgstr "تسجيل الدخول"

msgid "Create Your BookSlot Account"
msgstr "أنشئ حسابك في بوك سلوت"

msgid "Your Name"
msgstr "اسمك"

msgid "Email"
msgstr "البريد الإلكتروني"

msgid "Password"
msgstr "كلمة المرور"

msgid "Business Name"
msgstr "اسم النشاط التجاري"

msgid "Your Booking Page URL (e.g., bookslot.app/your-name)"
msgstr "رابط صفحة الحجز الخاصة بك (مثال: bookslot.app/your-name)"

msgid "Phone Number (for WhatsApp notifications, optional)"
msgstr "رقم الهاتف (لإشعارات واتساب، اختياري)"

msgid "Already have an account?"
msgstr "هل لديك حساب بالفعل؟"

