msgstr "الأربعاء"

msgid "Thursday"
msgstr "الخميس"

msgid "Friday"
msgstr "الجمعة"

msgid "Saturday"
msgstr "السبت"

msgid "Sunday"
msgstr "الأحد"

msgid "Add Availability"
msgstr "إضافة توفر"

msgid "Update Profile"
msgstr "تحديث الملف الشخصي"

msgid "Upcoming Bookings"
msgstr "الحجوزات القادمة"

msgid "Customer Name"
msgstr "اسم العميل"

msgid "Service"
msgstr "الخدمة"

msgid "Date"
msgstr "التاريخ"

msgid "Time"
msgstr "الوقت"

msgid "Customer Contact"
msgstr "معلومات اتصال العميل"

msgid "N/A"
msgstr "غير متوفر"

msgid "No upcoming bookings."
msgstr "لا توجد حجوزات قادمة."

msgid "Book an Appointment with {business_name}"
msgstr "احجز موعدًا مع {business_name}"

msgid "Your booking page URL:"
msgstr "رابط صفحة الحجز الخاصة بك:"

