msgstr "Nouvelle réservation reçue !"

msgid "Dear {owner.name},<br><br>You have received a new booking:<br>Client : {customer_name}<br>Email : {customer_email}<br>Téléphone : {customer_phone or 'N/A'}<br>Service : {service_name}<br>Heure : {booking_datetime.strftime('%Y-%m-%d %H:%M')}<br><br>Merci.<br>BookSlot"
msgstr "Cher {owner.name},<br><br>Vous avez reçu une nouvelle réservation :<br>Client : {customer_name}<br>Email : {customer_email}<br>Téléphone : {customer_phone or 'N/A'}<br>Service : {service_name}<br>Heure : {booking_datetime.strftime('%Y-%m-%d %H:%M')}<br><br>Merci.<br>BookSlot"

msgid "BookSlot: New booking for {service_name} at {booking_datetime.strftime('%H:%M')} on {booking_datetime.strftime('%Y-%m-%d')}. Customer: {customer_name}."
msgstr "BookSlot : Nouvelle réservation pour {service_name} à {booking_datetime.strftime('%H:%M')} le {booking_datetime.strftime('%Y-%m-%d')}. Client : {customer_name}."

msgid "Your Booking Confirmation"
msgstr "Votre confirmation de réservation"

msgid "Dear {customer_name},<br><br>Your booking for {service_name} with {owner.business_name} on {booking_datetime.strftime('%Y-%m-%d')} at {booking_datetime.strftime('%H:%M')} has been confirmed.<br><br>Thank you for using BookSlot.<br>"
msgstr "Cher {customer_name},<br><br>Votre réservation pour {service_name} avec {owner.business_name} le {booking_datetime.strftime('%Y-%m-%d')} à {booking_datetime.strftime('%H:%M')} a été confirmée.<br><br>Merci d'utiliser BookSlot.<br>"

msgid "Your booking with {owner.business_name} for {service_name} on {booking_datetime.strftime('%Y-%m-%d')} at {booking_datetime.strftime('%H:%M')} is confirmed. BookSlot"
msgstr "Votre réservation avec {owner.business_name} pour {service_name} le {booking_datetime.strftime('%Y-%m-%d')} à {booking_datetime.strftime('%H:%M')} est confirmée. BookSlot"

