msgid "Sign Up"
msgstr "S'inscrire"

msgid "Create Your BookSlot Account"
msgstr "Créer votre compte BookSlot"

msgid "Your Name"
msgstr "Votre nom"

msgid "Email"
msgstr "E-mail"

msgid "Password"
msgstr "Mot de passe"

msgid "Business Name"
msgstr "Nom de l'entreprise"

msgid "Public Booking Page URL Slug"
msgstr "Slug d'URL de la page de réservation publique"

msgid "Lowercase letters, numbers, and hyphens only. Min 3, max 50 characters."
msgstr "Lettres minuscules, chiffres et tirets uniquement. Min 3, max 50 caractères."

msgid "Phone Number (for WhatsApp notifications, optional)"
msgstr "Numéro de téléphone (pour les notifications WhatsApp, facultatif)"

msgid "Already have an account?"
msgstr "Vous avez déjà un compte ?"

msgid "Log In"
msgstr "Se connecter"

msgid "Login"
msgstr "Connexion"

msgid "Login to BookSlot"
msgstr "Se connecter à BookSlot"

msgid "Don't have an account?"
msgstr "Vous n'avez pas de compte ?"

msgid "Email already registered."
msgstr "E-mail déjà enregistré."

msgid "Business URL slug already taken."
msgstr "Le slug d'URL de l'entreprise est déjà pris."

msgid "An unexpected error occurred during signup."
msgstr "Une erreur inattendue est survenue lors de l'inscription."

msgid "Incorrect email or password."
msgstr "E-mail ou mot de passe incorrect."

msgid "Dashboard"
msgstr "Tableau de bord"

msgid "Welcome"
msgstr "Bienvenue"

msgid "Your Public Booking Page"
msgstr "Votre page de réservation publique"

msgid "Upcoming Bookings"
msgstr "Prochaines Réservations"

msgid "No upcoming bookings."
msgstr "Aucune réservation à venir."

msgid "Manage Your Profile"
msgstr "Gérer votre profil"

msgid "Services (JSON format)"
msgstr "Services (format JSON)"

msgid "Example: [{\"name\": \"Haircut\", \"duration\": 30}, {\"name\": \"Shave\", \"duration\": 15}]"
msgstr "Exemple : [{\"nom\": \"Coupe de cheveux\", \"durée\": 30}, {\"nom\": \"Rasage\", \"durée\": 15}]"

msgid "Availability (JSON format)"
msgstr "Disponibilité (format JSON)"

msgid "Example: {\"monday\": [{\"start\": \"09:00\", \"end\": \"17:00\"}], \"tuesday\": [{\"start\": \"10:00\", \"end\": \"18:00\"}]}"
msgstr "Exemple : {\"lundi\": [{\"début\": \"09:00\", \"fin\": \"17:00\"}], \"mardi\": [{\"début\": \"10:00\", \"fin\": \"18:00\"}]}"

msgid "Update Profile"
msgstr "Mettre à jour le profil"

msgid "Profile updated successfully!"
msgstr "Profil mis à jour avec succès !"

msgid "Invalid JSON format for services or availability."
msgstr "Format JSON invalide pour les services ou la disponibilité."

msgid "Services must be a list."
msgstr "Les services doivent être une liste."

msgid "Each service must have 'name' and 'duration'."
msgstr "Chaque service doit avoir un 'nom' et une 'durée'."

msgid "Availability must be a dictionary."
msgstr "La disponibilité doit être un dictionnaire."

msgid "Availability for {day} must be a list of slots."
msgstr "La disponibilité pour {day} doit être une liste de créneaux."

msgid "Each slot for {day} must have 'start' and 'end' times."
msgstr "Chaque créneau pour {day} doit avoir des heures de 'début' et de 'fin'."

msgid "An unexpected error occurred during profile update."
msgstr "Une erreur inattendue est survenue lors de la mise à jour du profil."

msgid "Book a Service"
msgstr "Réserver un Service"

msgid "Welcome! Book your service below."
msgstr "Bienvenue ! Réservez votre service ci-dessous."

msgid "Select Service"
msgstr "Sélectionner un service"

msgid "-- Choose a service --"
msgstr "-- Choisir un service --"

msgid "min"
msgstr "min"

msgid "Select Date"
msgstr "Sélectionner une date"

msgid "Select Time"
msgstr "Sélectionner une heure"

msgid "Book Now"
msgstr "Réserver maintenant"

msgid "Invalid date format."
msgstr "Format de date invalide."

msgid "Owner is not available on this day."
msgstr "Le propriétaire n'est pas disponible ce jour-là."

msgid "The selected time is not available or conflicts with existing bookings."
msgstr "L'heure sélectionnée n'est pas disponible ou est en conflit avec des réservations existantes."

msgid "An unexpected error occurred during booking. Please try again."
msgstr "Une erreur inattendue est survenue lors de la réservation. Veuillez réessayer."

msgid "Booking Confirmed!"
msgstr "Réservation Confirmée !"

msgid "Thank you for your booking with"
msgstr "Merci pour votre réservation avec"

msgid "You will receive a confirmation email shortly."
msgstr "Vous recevrez un e-mail de confirmation sous peu."

msgid "Book another service"
msgstr "Réserver un autre service"

msgid "Your Booking Confirmation"
msgstr "Votre confirmation de réservation"

msgid "Dear"
msgstr "Cher"

msgid "Your booking with {} is confirmed!"
msgstr "Votre réservation avec {} est confirmée !"

msgid "Your booking with"
msgstr "Votre réservation avec"

msgid "is confirmed."
msgstr "est confirmée."

msgid "Service"
msgstr "Service"

msgid "Date"
msgstr "Date"

msgid "Time"
msgstr "Heure"

msgid "We look forward to seeing you!"
msgstr "Nous sommes impatients de vous voir !"

msgid "Regards,"
msgstr "Cordialement,"

msgid "New Booking Notification"
msgstr "Nouvelle notification de réservation"

msgid "New booking received for {}!"
msgstr "Nouvelle réservation reçue pour {} !"

msgid "New Booking Received!"
msgstr "Nouvelle réservation reçue !"

msgid "You have a new booking:"
msgstr "Vous avez une nouvelle réservation :"

msgid "Customer Name"
msgstr "Nom du client"

msgid "Customer Email"
msgstr "E-mail du client"

msgid "Customer Phone"
msgstr "Téléphone du client"

msgid "N/A"
msgstr "N/A"

msgid "Check your dashboard for more details."
msgstr "Consultez votre tableau de bord pour plus de détails."

msgid "New booking for {service_name} on {date} at {time} by {customer_name}. Customer phone: {customer_phone}"
msgstr "Nouvelle réservation pour {service_name} le {date} à {time} par {customer_name}. Téléphone du client : {customer_phone}"
