msgid "New Booking Received for {service_name}"
msgstr "تم استلام حجز جديد لـ {service_name}"

msgid """
        <p>Dear {owner_name},</p>
        <p>You have received a new booking!</p>
        <ul>
            <li><strong>Customer:</strong> {customer_name}</li>
            <li><strong>Service:</strong> {service_name}</li>
            <li><strong>Date:</strong> {booking_date}</li>
            <li><strong>Time:</strong> {booking_time}</li>
        </ul>
        <p>Please check your dashboard for more details.</p>
        <p>Thank you,<br>BookSlot Team</p>
    """
msgstr """
        <p>عزيزي {owner_name}،</p>
        <p>لقد تلقيت حجزًا جديدًا!</p>
        <ul>
            <li><strong>العميل:</strong> {customer_name}</li>
            <li><strong>الخدمة:</strong> {service_name}</li>
            <li><strong>التاريخ:</strong> {booking_date}</li>
            <li><strong>الوقت:</strong> {booking_time}</li>
        </ul>
        <p>يرجى التحقق من لوحة التحكم الخاصة بك لمزيد من التفاصيل.</p>
        <p>شكراً لك،<br>فريق BookSlot</p>
    """

msgid "New booking: {customer_name} for {service_name} on {booking_date} at {booking_time}."
msgstr "حجز جديد: {customer_name} لـ {service_name} في {booking_date} الساعة {booking_time}."

msgid "Your Booking Confirmation with {business_name}"
msgstr "تأكيد حجزك مع {business_name}"

msgid """
        <p>Dear {customer_name},</p>
        <p>Your booking with {business_name} has been confirmed!</p>
        <ul>
            <li><strong>Service:</strong> {service_name}</li>
            <li><strong>Date:</strong> {booking_date}</li>
            <li><strong>Time:</strong> {booking_time}</li>
            <li><strong>Business:</strong> {business_name} ({owner_name})</li>
        </ul>
        <p>We look forward to seeing you!</p>
        <p>Thank you,<br>{business_name}</p>
    """
msgstr """
        <p>عزيزي {customer_name}،</p>
        <p>تم تأكيد حجزك مع {business_name}!</p>
        <ul>
            <li><strong>الخدمة:</strong> {service_name}</li>
            <li><strong>التاريخ:</strong> {booking_date}</li>
            <li><strong>الوقت:</strong> {booking_time}</li>
            <li><strong>العمل:</strong> {business_name} ({owner_name})</li>
        </ul>
        <p>نتطلع لرؤيتك!</p>
        <p>شكراً لك،<br>فريق BookSlot</p>
    """

msgid "Your booking with {business_name} for {service_name} on {booking_date} at {booking_time} is confirmed!"
msgstr "تم تأكيد حجزك مع {business_name} لـ {service_name} في {booking_date} الساعة {booking_time}!"
