msgid "New Booking Received for {service_name}"
msgstr "Nouvelle réservation reçue pour {service_name}"

msgid """
        <p>Dear {owner_name},</p>
        <p>You have received a new booking!</p>
        <ul>
            <li><strong>Client :</strong> {customer_name}</li>
            <li><strong>Service :</strong> {service_name}</li>
            <li><strong>Date :</strong> {booking_date}</li>
            <li><strong>Heure :</strong> {booking_time}</li>
        </ul>
        <p>Veuillez consulter votre tableau de bord pour plus de détails.</p>
        <p>Merci,<br>L'équipe BookSlot</p>
    """
msgstr """
        <p>Cher {owner_name},</p>
        <p>Vous avez reçu une nouvelle réservation !</p>
        <ul>
            <li><strong>Client :</strong> {customer_name}</li>
            <li><strong>Service :</strong> {service_name}</li>
            <li><strong>Date :</strong> {booking_date}</li>
            <li><strong>Heure :</strong> {booking_time}</li>
        </ul>
        <p>Veuillez consulter votre tableau de bord pour plus de détails.</p>
        <p>Merci,<br>L'équipe BookSlot</p>
    """

msgid "New booking: {customer_name} for {service_name} on {booking_date} at {booking_time}."
msgstr "Nouvelle réservation : {customer_name} pour {service_name} le {booking_date} à {booking_time}."

msgid "Your Booking Confirmation with {business_name}"
msgstr "Votre confirmation de réservation avec {business_name}"

msgid """
        <p>Dear {customer_name},</p>
        <p>Your booking with {business_name} has been confirmed!</p>
        <ul>
            <li><strong>Service :</strong> {service_name}</li>
            <li><strong>Date :</strong> {booking_date}</li>
            <li><strong>Heure :</strong> {booking_time}</li>
            <li><strong>Entreprise :</strong> {business_name} ({owner_name})</li>
        </ul>
        <p>We look forward to seeing you!</p>
        <p>Merci,<br>{business_name}</p>
    """
msgstr """
        <p>Cher {customer_name},</p>
        <p>Votre réservation avec {business_name} a été confirmée !</p>
        <ul>
            <li><strong>Service :</strong> {service_name}</li>
            <li><strong>Date :</strong> {booking_date}</li>
            <li><strong>Heure :</strong> {booking_time}</li>
            <li><strong>Entreprise :</strong> {business_name} ({owner_name})</li>
        </ul>
        <p>Nous sommes impatients de vous voir !</p>
        <p>Merci,<br>{business_name}</p>
    """

msgid "Your booking with {business_name} for {service_name} on {booking_date} at {booking_time} is confirmed!"
msgstr "Votre réservation avec {business_name} pour {service_name} le {booking_date} à {booking_time} est confirmée !"
