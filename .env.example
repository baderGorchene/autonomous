# Example .env file for BookSlot application
# Copy this file to .env and fill in your actual production values.

# --- Core Application Settings ---
# A strong, randomly generated secret key for JWT authentication.
# Minimum 32 characters recommended.
SECRET_KEY="your_super_secret_key_here_at_least_32_chars"

# Base URL of the application. MUST be your public domain in production (e.g., https://bookslot.app)
SERVER_NAME="http://localhost:8000"

# Database URL. For production, use a robust database like PostgreSQL.
# Example for PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL="sqlite:///./sql_app.db"

# Set to 'False' for production environments.
TESTING=False

# Default language for the application (e.g., 'en', 'ar', 'fr')
DEFAULT_LOCALE="en"

# --- Email Notification Settings (SendGrid) ---
# Required for sending email confirmations and notifications.
SENDGRID_API_KEY="your_sendgrid_api_key"

# --- WhatsApp Notification Settings (Twilio) ---
# Required for sending WhatsApp notifications.
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# Your Twilio WhatsApp sender number, e.g., 'whatsapp:+1234567890'
TWILIO_WHATSAPP_NUMBER="whatsapp:+1XXXXXXXXXX"

# --- Other API Keys (Currently not used, but included for completeness) ---
GEMINI_API_KEY="your_gemini_api_key"