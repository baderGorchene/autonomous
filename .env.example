# .env.example - Rename to .env and fill in your values

# FastAPI Secret Key for JWT and Session Middleware
# IMPORTANT: Change this to a strong, random string in production!
SECRET_KEY="your-super-secret-key"

# Algorithm for JWT (default: HS256)
ALGORITHM="HS256"

# Access Token Expiration in Minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SendGrid API Key for Email Notifications
# Get one from https://sendgrid.com/
SENDGRID_API_KEY="your_sendgrid_api_key"

# Twilio Account SID and Auth Token for WhatsApp Notifications
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
# Your Twilio WhatsApp enabled number (e.g., +1XXXXXXXXXX)
TWILIO_WHATSAPP_NUMBER="+1XXXXXXXXXX"

# Database URL (SQLite for development, PostgreSQL for production)
# SQLite: sqlite:///./sql_app.db
# PostgreSQL Example: postgresql://user:password@host:port/dbname
DATABASE_URL="sqlite:///./sql_app.db"

# Set to True for testing environment (e.g., to disable external services if needed)
TESTING=False

# Gemini API Key (Currently not used in the application, but kept for future expansion)
GEMINI_API_KEY=""
