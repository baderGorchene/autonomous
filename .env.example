# .env.example
# This file serves as an example for environment variables required by BookSlot.
# Create a .env file in the project root based on this example,
# and fill in your actual API keys and other configurations.

# --- Application Settings ---
SECRET_KEY="your-super-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- External Service API Keys ---
# SendGrid for email notifications
SENDGRID_API_KEY="YOUR_SENDGRID_API_KEY"

# Twilio for WhatsApp notifications
TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_WHATSAPP_NUMBER="whatsapp:+1234567890" # Your Twilio WhatsApp enabled number, e.g., whatsapp:+14155238886

# Google Gemini (Optional, if integrated for AI features)
GEMINI_API_KEY=""

# --- Database Configuration ---
# For local development, SQLite is used by default.
# For production, it's highly recommended to use a robust database like PostgreSQL.
DATABASE_URL="sqlite:///./bookslot.db"
# Example for PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:port/database_name"